{
  "name": "gignaati-workbench",
  "version": "1.0.1",
  "description": "A simple agentic platform for managing AI agents and automating tasks.",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "Gignaati",
  "license": "ISC",
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "sqlite3": "^5.1.7",
    "systeminformation": "^5.27.7"
  },
  "build": {
    "appId": "com.gignaati.workbench",
    "productName": "Gignaati Workbench",
    "icon": "Icon-Gignaati.ico",
    "publish": [
      {
        "provider": "generic",
        "url": "https://api.gignaati.com/download/"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/backend/",
        "to": "backend/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Gignaati",
      "icon": "build/icon.png",
      "synopsis": "A simple agentic platform"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    }
  }
}